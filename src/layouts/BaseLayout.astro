---
// src/layouts/BaseLayout.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { cn } from "../utils/cn";

interface Props {
    title: string;
    class?: string;
}

const { title = "noscere.uk", class: className } = Astro.props;

// Consolidated design token root: clear slate aesthetic, antialiased subpixels
const htmlClasses = "bg-slate-950 text-slate-100 antialiased";
---

<!doctype html>
<html lang="en" class={cn("no-js", htmlClasses)}>
    <head>
        <meta charset="utf-8" />
        <meta name="description" content="Noscere Engineering Portfolio" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <script is:inline>
            document.documentElement.classList.replace("no-js", "js");
        </script>
    </head>

    {
        /* Flex-col min-h-screen enforces sticky footers naturally across all routing pools */
    }
    <body class="flex min-h-screen flex-col justify-between">
        <Header />

        {/* The Macro Layout Grid Shell */}
        {/* flex-grow resolves mobile Chrome layout stretching rules safely */}
        <main
            class={cn(
                "flex-grow flex flex-col w-full max-w-3xl mx-auto px-6 py-12 sm:py-16",
                className
            )}
        >
            <slot />
        </main>

        <Footer />
    </body>
</html>
