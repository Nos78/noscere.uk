---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import SkillsFilter from "../components/SkillsFilter.astro"; // <-- Import the component
---

<BaseLayout title="noscere.uk | Home">
	<main
		class="flex flex-col items-center justify-center min-h-screen p-6 py-16"
	>
		<div class="max-w-xl text-center space-y-4">
			<h1
				class="text-5xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400"
			>
				noscere.uk
			</h1>
			<p class="text-slate-400 text-lg">
				Systems logic meets clean user experience. Welcome to the
				sandbox. Noscere Velle Audere Tacere Facere Ire.<br /><i
					>To know, to will, to dare, to do, to keep silent, to go</i
				>
			</p>
			<div class="pt-2">
				<span
					class="px-3 py-1 text-xs font-mono font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-full"
				>
					Tailwind + Astro Engine Active
				</span>
			</div>
		</div>

		<SkillsFilter />

		<div class="mt-8 text-center">
			<a
				href="/blog"
				class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-xl border border-slate-800 bg-slate-900/20 text-slate-300 hover:text-emerald-400 hover:border-emerald-500/30 transition-all duration-200"
			>
				Read the Engineering Blog →
			</a>
		</div>
	</main>
</BaseLayout>
