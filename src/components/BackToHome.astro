---
// src/components/BackToHome.astro
import type { ComponentProps } from "astro/types";
import Back from "./Back.astro";

interface Props extends ComponentProps<typeof Back> {
    returnHome?: boolean;
}

const { returnHome = false, ...rest } = Astro.props;
---

<Back text={returnHome ? "Return Home" : "Back to Home"} href="/" {...rest} />
