---
// src/components/Header.astro
---

<header
    class="w-full text-zinc-500 items-center justify-center text-center p-6 border-b border-zinc-800 bg-zinc-950/50"
>
    <h1
        class="text-5xl font-black tracking-tight leading-tight text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400 mb-1"
    >
        noscere.uk
    </h1><p
        class="mb-1 font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400/50 to-cyan-400/50"
    >
        Noscere Velle Audere Tacere Facere Ire.
    </p><i
        class="mb-12 text-normal font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-800/50 to-cyan-800/50"
        >To know, to will, to dare, to do, to keep silent, to go</i
    >
    <div class="pt-2 mt-2">
        <span
            class="px-3 py-1 text-xs font-mono font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-full"
        >
            Tailwind + Astro Engine Active
        </span>
    </div>
</header>
