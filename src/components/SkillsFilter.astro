---
// src/components/SkillsFilter.astro
import { skills, categories } from "../data/cvData";
---

<div
    class="w-full max-w-4xl mx-auto p-6 bg-slate-900/40 border border-slate-800 rounded-2xl backdrop-blur-sm"
>
    <h2 class="text-xl font-bold mb-4 text-slate-200 tracking-tight">
        Technical Competencies
    </h2>

    <div class="flex flex-wrap gap-2 mb-6" id="filter-buttons">
        {
            categories.map((cat) => (
                <button
                    data-category={cat}
                    class="filter-btn px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-200 capitalize bg-slate-800/50 border-slate-700 text-slate-300 hover:border-emerald-500/50"
                >
                    {cat}
                </button>
            ))
        }
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="skills-grid">
        {
            skills.map((skill) => (
                <div
                    data-skill-cat={skill.category}
                    class="skill-card p-3 text-sm font-mono border border-slate-800 bg-slate-950/60 rounded-xl flex flex-col items-start justify-between gap-2 text-slate-300 transition-all duration-300"
                >
                    <div class="flex w-full items-center justify-between">
                        <span class="font-bold text-slate-100">
                            {skill.name}
                        </span>
                    </div>

                    <div class="flex w-full items-center justify-between pt-1 border-t border-slate-900 text-[10px]">
                        <span class="uppercase tracking-wider px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 font-sans">
                            {skill.category}
                        </span>
                        <span class="text-emerald-400 font-sans font-semibold">
                            {skill.level}
                        </span>
                    </div>
                </div>
            ))
        }
    </div>
</div>

<script>
    // 2. THE CLIENT-SIDE SCRIPT
    // This code executes entirely in the user's browser, not at build time!

    const buttons = document.querySelectorAll(".filter-btn");
    const cards = document.querySelectorAll(".skill-card");

    // Set the 'all' button as active by default
    const allButton = document.querySelector('[data-category="all"]');
    if (allButton)
        allButton.classList.add(
            "border-emerald-500",
            "text-emerald-400",
            "bg-emerald-500/5"
        );

    buttons.forEach((button) => {
        button.addEventListener("click", () => {
            const selectedCategory = button.getAttribute("data-category");

            // Update active button state styling
            buttons.forEach((btn) =>
                btn.classList.remove(
                    "border-emerald-500",
                    "text-emerald-400",
                    "bg-emerald-500/5"
                )
            );
            button.classList.add(
                "border-emerald-500",
                "text-emerald-400",
                "bg-emerald-500/5"
            );

            // Filter cards with smooth visual transitions
            cards.forEach((card) => {
                const cardCat = card.getAttribute("data-skill-cat");

                if (
                    selectedCategory === "all" ||
                    cardCat === selectedCategory
                ) {
                    // Show component
                    card.classList.remove(
                        "opacity-20",
                        "scale-95",
                        "pointer-events-none"
                    );
                } else {
                    // Dim / Filter out component
                    card.classList.add(
                        "opacity-20",
                        "scale-95",
                        "pointer-events-none"
                    );
                }
            });
        });
    });
</script>
